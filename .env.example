# Copy to .env.local for local development. Never commit .env.local or any
# file containing real values — .gitignore already excludes .env*.local.

# --- Supabase (auth + database for /ecoadmin) -------------------------------
# Standard Supabase + Next.js naming convention. The anon key is safe to
# expose to the browser by design (NEXT_PUBLIC_*) — access is governed by
# the Row Level Security policies in supabase/migrations/0001_ecoadmin_schema.sql,
# not by keeping this key secret.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Resend (outbound email) -------------------------------------------------
# Server-only. Never prefix with NEXT_PUBLIC_. Only read inside
# app/api/ecoadmin/email/send/route.ts — never imported into a "use client"
# file or sent to the browser in any response.
# Leave unset until Resend domain verification for ecostructdynamicsltd.com
# is complete — the send API detects this and returns a clear
# "not configured" error instead of pretending to send.
RESEND_API_KEY=
